# Coolify / Docker / local environment
# Copy these into Coolify → Environment Variables, or `cp .env.example .env`

# --- Dashboard ---
HOST=0.0.0.0
PORT=3001
DATA_DIR=/data

# --- Wallet (required) ---
# Export from MetaMask / Polymarket proxy. Format: 0x...
POLYMARKET_PRIVATE_KEY=your_private_key_here

# --- Bot ---
# Risk budget used for position sizing (not your on-chain balance)
CAPITAL_USD=50

# true = simulation (no real orders). false = live trading.
DRY_RUN=true

# --- Strategies (all off unless set to true) ---
ARBITRAGE_ENABLED=false
DIPARB_ENABLED=false
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false

# --- Prediction Hunt (cross-platform +EV / arb) ---
# Get a key at https://www.predictionhunt.com/api/docs/quickstart
PREDICTION_HUNT_API_KEY=
PREDICTION_HUNT_API_URL=https://www.predictionhunt.com/api/v2
PREDICTION_HUNT_ENABLED=true
# Dev/Pro monthly quota is tight — default 15 minutes per scan
PREDICTION_HUNT_POLL_MS=900000
PREDICTION_HUNT_ARB_MIN_ROI=0.5
PREDICTION_HUNT_EV_MIN_ROI=1
PREDICTION_HUNT_LIMIT=50
